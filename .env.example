# Copy file nay thanh .env roi chinh neu can: cp .env.example .env
# Docker Desktop (WSL2) mac dinh chi cap ~50% RAM may; tong cac container
# duoi day ~6-7GB. Neu thieu RAM, giam SPARK_WORKER_MEMORY truoc.

SPARK_IMAGE_TAG=3.5.8-java17-python3
SPARK_WORKER_CORES=4
SPARK_WORKER_MEMORY=2g

ELASTIC_STACK_VERSION=8.19.14
ES_JAVA_OPTS=-Xms1g -Xmx1g
# Connector Spark -> ES (elasticsearch-spark-30_2.12) duoc build san vao image
# Spark (docker/spark/Dockerfile) theo dung ELASTIC_STACK_VERSION.

# Chuoi ngau nhien >= 32 ky tu, bat buoc cho Kibana Alerting
KIBANA_ENCRYPTION_KEY=change-me-to-a-random-string-of-32-chars-or-more

HADOOP_IMAGE_TAG=2.0.0-hadoop3.2.1-java8

# Cong UI tren host - doi neu bi trung voi project khac dang chay
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
SPARK_DRIVER_UI_PORT=4040
